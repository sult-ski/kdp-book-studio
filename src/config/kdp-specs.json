      "gutenbergLicense": "https://www.gutenberg.org/policy/license.html",
      "aiReported": "https://undetectable.ai/blog/books-written-by-ai-on-amazon/",
      "storeLinksReported": "https://www.ebookpbook.com/2026/05/13/ebook-hyperlinks-kindle-broken/",
      "contentQuality": "https://kdp.amazon.com/en_US/help/topic/G200952510",
      "bonusContent": "https://kdp.amazon.com/en_US/help/topic/G202018960",
      "freelyAvailableReported": "https://www.kdpcommunity.com/s/question/0D5f400000FHsdMCAT/book-blocked-and-no-i-did-not-steal-content-from-the-web?language=en_US",
      "amazonReviewsPolicy": "https://www.amazon.com/gp/help/customer/display.html?nodeId=GLHXEX85MENUE4XF",
      "metadataGuidelines": "https://kdp.amazon.com/en_US/help/topic/G201097560",
      "isbnMismatchReported": "https://www.publishing.co.uk/guides/kdp-error-isbn-mismatch/"
    },
    "rules": [
      {
        "id": "gutenberg",
        "label": "Project Gutenberg text",
        "severity": "fail",
        "accuracy": "verified",
        "evidence": "both",
        "source": "publicDomain",
        "patterns": [
          "\\*{3}\\s*START OF (THE|THIS) PROJECT GUTENBERG EBOOK",
          "\\*{3}\\s*END OF (THE|THIS) PROJECT GUTENBERG"
        ],
        "phrases": [
          "THE FULL PROJECT GUTENBERG LICENSE",
          "Project Gutenberg Literary Archive Foundation",
          "This eBook is for the use of anyone anywhere"
        ]
      },
      {
        "id": "gutenbergMention",
        "label": "Possible Project Gutenberg source",
        "severity": "warn",
        "accuracy": "best-effort",
        "evidence": "reported",
        "source": "publicDomain",
        "patterns": [
          "gutenberg\\.org",
          "\\bProject Gutenberg\\b"
        ],
        "phrases": [
          "Distributed Proofreaders",
          "Transcriber's Note"
        ],
        "skipIfRule": "gutenberg"
      },
      {
        "id": "placeholder",
        "label": "Placeholder text",
        "severity": "fail",
        "accuracy": "verified",
        "evidence": "official",
        "source": "printGuidelines2018",
        "patterns": [
          "lorem ipsum",
          "dolor sit amet",
          "consectetur adipiscing",
          "\\[(insert|your|author|add|enter)[^\\]]{0,60}\\]",
          "\\bChapter (\\?\\?|#{1,3}|_{2,})(?![\\w#_?])"
        ],
        "caseSensitivePatterns": [
          "\\bTODO\\b"
        ],
        "phrases": [
          "Author Name Here",
          "Book Title Here",
          "Click here to add text",
          "Type your text here",
          "Insert chapter here"
        ],
        "_note": "\"Chapter X\"/\"Chapter XX\" from the research is left out: X and XX are also Roman numerals 10 and 20. TODO matches upper case only."
      },
      {
        "id": "storeLinks",
        "label": "Link to another ebook store",
        "severity": "fail",
        "accuracy": "verified",
        "evidence": "official",
        "source": "contentQuality",
        "target": "urls",
        "patterns": [
          "books\\.apple\\.com",
          "itunes\\.apple\\.com",
          "(?<![\\w-])kobo\\.com",
          "barnesandnoble\\.com",
          "(?<![\\w-])nook\\.com",
          "smashwords\\.com",
          "draft2digital\\.com",
          "books2read\\.com",
          "play\\.google\\.com/store/books",
          "books\\.google\\.com"
        ]
      },
      {
        "id": "storeMentions",
        "label": "Mentions another ebook store",
        "severity": "warn",
        "accuracy": "best-effort",
        "evidence": "official",
        "source": "contentQuality",
        "patterns": [
          "available (on|at|from) .{0,40}(Apple Books|iBooks|Kobo|Barnes|Nook|Google Play|Smashwords|all (major )?retailers)"
        ]
      },
      {
        "id": "aiLeftovers",
        "label": "Leftover AI chatbot text",
        "severity": "warn",
        "accuracy": "best-effort",
        "evidence": "reported",
        "source": "aiReported",
        "patterns": [
          "Thought for \\d+ seconds",
          "to align more with .{1,40}'s style"
        ],
        "phrases": [
          "As an AI language model",
          "As of my last knowledge update",
          "I've rewritten the passage",
          "Here's an advanced version of your passage",
          "Let me know if you'd like",
          "Would you like me to",
          "Regenerate response"
        ],
        "followUp": "aiDisclosure"
      },
      {
        "id": "newsletterLinks",
        "label": "Newsletter or sign-up link",
        "severity": "info",
        "accuracy": "best-effort",
        "evidence": "official",
        "source": "contentQuality",
        "target": "urls",
        "patterns": [
          "mailchimp",
          "list-manage\\.com",
          "convertkit",
          "(?<![\\w-])kit\\.com",
          "mailerlite",
          "bookfunnel",
          "substack\\.com/subscribe",
          "forms\\.gle",
          "docs\\.google\\.com/forms",
          "(?<![\\w-])bit\\.ly/"
        ]
      },
      {
        "id": "freelyAvailable",
        "label": "Text that may be freely available elsewhere",
        "severity": "warn",
        "accuracy": "best-effort",
        "evidence": "both",
        "source": "contentGuidelines",
        "phrases": [
          "originally published on",
          "first appeared on my blog",
          "Wattpad",
          "Royal Road",
          "Archive of Our Own",
          "fanfiction.net",
          "Creative Commons",
          "private label rights",
          "resell rights",
          "master resell rights"
        ],
        "patterns": [
          "\\bAO3\\b",
          "\\bCC BY(-[A-Z]{2})*\\b",
          "\\bPLR\\b"
        ]
      },
      {
        "id": "companionGuide",
        "label": "Summary or companion guide",
        "severity": "warn",
        "accuracy": "best-effort",
        "evidence": "official",
        "source": "contentGuidelines",
        "caseSensitivePatterns": [
          "\\b(Summary|SUMMARY) (of|OF) [A-Z].{0,80} (by|BY) [A-Z]",
          "^\\s*(Summary|Study Guide|Workbook|Analysis|SUMMARY|STUDY GUIDE|WORKBOOK|ANALYSIS) (of|for|OF|FOR)\\b"
        ],
        "_note": "The heading pattern is case-sensitive: a PDF line that starts mid-sentence with \"analysis of\" is not a title.",
        "phrases": [
          "Workbook for",
          "Key Takeaways from",
          "This is an unofficial"
        ]
      },
      {
        "id": "redirect",
        "label": "Content readers must get somewhere else",
        "severity": "warn",
        "accuracy": "best-effort",
        "evidence": "official",
        "source": "contentQuality",
        "phrases": [
          "to continue reading",
          "read the rest at",
          "download the full",
          "subscribe to get the next chapter",
          "access the full content at",
          "scan the QR code to read"
        ]
      },
      {
        "id": "incentivisedReviews",
        "label": "Rewards for reviews",
        "severity": "warn",
        "accuracy": "best-effort",
        "evidence": "official",
        "source": "amazonReviewsPolicy",
        "patterns": [
          "\\b(5|five)[- ]star (review|rating)s?\\b",
          "\\bin exchange for (a|an|your)( honest)? review\\b",
          "gift card[\\s\\S]{0,80}\\breview|\\breview[\\s\\S]{0,80}gift card",
          "\\b(free|bonus)[\\s\\S]{0,40}\\bfor (leaving|writing) a review\\b"
        ],
        "_note": "Polite requests (\"please leave a review\") are allowed and not matched."
      },
      {
        "id": "lyricsQuotes",
        "label": "Song lyrics or quotations",
        "severity": "info",
        "accuracy": "best-effort",
        "evidence": "official",
        "source": "contentGuidelines",
        "phrases": [
          "lyrics by",
          "words and music by"
        ],
        "_note": "The research's quote-with-attribution regex is not used: it matches every epigraph. Only explicit lyric credits are flagged."
      }
    ],
    "aiDisclosure": {
      "severity": "info",
      "source": "contentGuidelines",
      "evidence": "official"
    },
    "context": {
      "_note": "D3: what the author tells us about the book. Contexts change severities of rules that would be false alarms for that kind of book (\"off\" hides the rule). Research: 'Let users mark context (genre, PD-annotated edition, AI-themed book, typography book, hymnal or liturgy, children's audience), since these settings remove most false positives.'",
      "genres": [
        { "id": "general", "label": "General fiction or non-fiction" },
        { "id": "romance", "label": "Romance" },
        { "id": "erotica", "label": "Erotica" },
        { "id": "poetry", "label": "Poetry" },
        { "id": "religion", "label": "Religion, hymns or liturgy" }
      ],
      "audiences": [
        { "id": "adult", "label": "Adults or teens" },
        { "id": "children", "label": "Children (up to 12)" }
      ],
      "contexts": {
        "pdAnnotated": { "label": "Annotated, translated or illustrated public-domain edition", "overrides": { "gutenbergMention": "info" } },
        "aiThemed": { "label": "Book about AI or chatbots", "overrides": { "aiLeftovers": "info" } },
        "typography": { "label": "Book about typography or design", "overrides": { "placeholder": "warn" } },
        "hymnal": { "label": "Hymnal, songbook or liturgy", "overrides": { "lyricsQuotes": "off", "duplicate": "off", "repeatedHeading": "off" } }
      },
      "_overridesNote": "Typography only lowers placeholder text to a warning: KDP's rule has no exception, so a specimen 'Lorem ipsum' can still be rejected. Gutenberg licence/header text stays Must fix in every context."
    },
